# Archived, not a live workflow — moved out of .github/workflows/ on
# 2026-10-15 once the systemd-timer-on-Pi replacement was confirmed
# working unattended. Kept for reference: this is what ran the scraper
# on GitHub Actions' shared datacenter IPs before Cloudflare started
# blocking those ranges. See docs/OPERATIONAL.md for the root-cause
# finding and PLANS.md for the Pi-based replacement.
name: Hourly Gym Scrape

on:
  workflow_dispatch:

jobs:
  scrape:
    runs-on: windows-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Cache pip packages
        uses: actions/cache@v4
        with:
          path: ~\AppData\Local\pip\Cache
          key: ${{ runner.os }}-pip-${{ hashFiles('requirements.txt') }}

      - name: Cache Playwright browsers
        uses: actions/cache@v4
        with:
          path: ~\AppData\Local\ms-playwright
          key: ${{ runner.os }}-playwright-${{ hashFiles('requirements.txt') }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          playwright install chromium --with-deps

      - name: Run Scraper
        env:
          PYTHONPATH: "."
          WEBSITE_URL: ${{ secrets.WEBSITE_URL }}
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          ACTIVE_SG_API: ${{ secrets.ACTIVE_SG_API }}
          GITHUB_ACTIONS: "true"
        run: python services/scraper/main_scraper.py

      - name: Upload Debug Screenshot
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: scraper-debug-images
          path: debug_timeout.png
